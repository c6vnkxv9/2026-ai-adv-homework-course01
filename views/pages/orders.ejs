<div id="app" class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
  <h1 class="text-2xl font-bold text-ink mb-6" style="font-family: 'Noto Serif TC', serif;">我的訂單</h1>

  <div v-if="loading" class="flex justify-center py-16">
    <div class="w-8 h-8 border-2 border-ink/20 border-t-peony rounded-full animate-spin"></div>
  </div>

  <div v-else-if="orders.length === 0" class="text-center py-16 border border-ink/15">
    <span class="material-symbols-outlined text-4xl text-ink/40" data-icon="inventory_2">inventory_2</span>
    <p class="text-ink/70 mt-3 mb-1">尚無訂單</p>
    <p class="text-ink/50 text-sm mb-4">快去選購喜歡的花束吧！</p>
    <a href="/" class="inline-block bg-peony text-paper px-6 py-2 text-sm hover:bg-peony/90 transition-colors">去逛逛</a>
  </div>

  <div v-else class="border border-ink/15 divide-y divide-ink/10">
    <a
      v-for="order in orders"
      :key="order.id"
      :href="'/orders/' + order.id"
      class="flex items-center justify-between p-5 hover:bg-ink/[0.02] transition-colors"
    >
      <div>
        <p class="text-sm text-ink/70">訂單編號：{{ order.order_no }}</p>
        <p class="text-xs text-ink/50 mt-1">{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</p>
      </div>
      <div class="flex items-center gap-4">
        <span class="font-bold text-ink">NT$ {{ order.total_amount.toLocaleString() }}</span>
        <span
          class="text-xs px-3 py-1 rounded-full font-medium"
          :class="statusMap[order.status]?.cls || 'border border-ink/30 text-ink/60'"
        >
          {{ statusMap[order.status]?.label || order.status }}
        </span>
        <span class="material-symbols-outlined text-ink/40" data-icon="chevron_right">chevron_right</span>
      </div>
    </a>
  </div>
</div>
