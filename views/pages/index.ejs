<div id="app">
  <!-- Hero -->
  <section class="border-b border-ink/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-stretch">
        <!-- Text -->
        <div class="lg:col-span-6 flex flex-col justify-between order-2 lg:order-1">
          <div>
            <h1
              class="font-bold text-4xl sm:text-5xl lg:text-6xl text-ink tracking-tight leading-[1.2] mb-6"
              style="font-family: 'Noto Serif TC', serif;"
            >
              讓花，<br>說你想說的話。
            </h1>
            <p class="text-ink/80 text-base sm:text-lg leading-relaxed max-w-md mb-8">
              從一束到一室，找到今天想送的心意。不附層層亮面玻璃紙，保留花枝本身剛從產地剪下的樣子。
            </p>
          </div>
          <div class="space-y-6 pt-6 border-t border-ink/10">
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-moss mt-0.5" data-icon="schedule">schedule</span>
              <div>
                <p class="text-sm font-medium text-ink">台北市區・今日 13:00 前訂購最快當日送達</p>
                <p class="text-xs text-ink/60 mt-0.5">全台其他縣市冷藏配送，翌日中午前送達</p>
              </div>
            </div>
            <a
              href="#products"
              class="inline-block font-bold text-lg text-ink pb-1 border-b-2 border-peony hover:text-peony transition-colors"
              style="font-family: 'Noto Serif TC', serif;"
            >
              前往選購今日鮮花
            </a>
          </div>
        </div>
        <!-- Image bleed -->
        <div class="lg:col-span-6 order-1 lg:order-2">
          <div class="relative w-full h-72 sm:h-96 lg:h-full min-h-[320px] border border-ink/15 overflow-hidden">
            <img
              src="https://images.unsplash.com/photo-1487530811176-3780de880c2d?w=900"
              alt="花束特寫"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 本季精選 -->
  <section class="border-b border-ink/10" v-if="!loading && products.length > 0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14">
      <div class="flex items-baseline justify-between mb-8 pb-3 border-b border-ink/10">
        <h2 class="font-bold text-2xl sm:text-3xl text-ink" style="font-family: 'Noto Serif TC', serif;">本季精選</h2>
        <span class="text-xs text-ink/50 hidden sm:inline">依產地與到貨批次更新</span>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <article
          v-for="(product, idx) in products.slice(0, 4)"
          :key="product.id"
          @click="goToProduct(product.id)"
          class="relative border border-ink/20 tag-corner p-3 sm:p-4 cursor-pointer hover:border-ink transition-colors group"
        >
          <div class="tag-hole"></div>
          <div class="aspect-square overflow-hidden border border-ink/10 mb-3">
            <img
              :src="product.image_url || featuredImages[idx % 4]"
              :alt="product.name"
              class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
            />
          </div>
          <h3 class="font-medium text-sm text-ink truncate">{{ product.name }}</h3>
          <p class="text-peony font-bold mt-1">NT$ {{ product.price.toLocaleString() }}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 全部商品 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14" id="products">
    <div class="flex items-baseline justify-between mb-8 pb-3 border-b border-ink/10">
      <h2 class="font-bold text-2xl sm:text-3xl text-ink" style="font-family: 'Noto Serif TC', serif;">探索所有花藝</h2>
      <span class="text-xs text-ink/50 hidden sm:inline">找到屬於您的那束花</span>
    </div>

    <div v-if="loading" class="flex justify-center py-16">
      <div class="w-8 h-8 border-2 border-ink/20 border-t-peony rounded-full animate-spin"></div>
    </div>

    <template v-else>
      <div v-if="products.length === 0" class="text-center py-16 border border-ink/15">
        <span class="material-symbols-outlined text-3xl text-ink/40" data-icon="local_florist">local_florist</span>
        <p class="text-ink/70 mt-3">目前沒有商品</p>
        <p class="text-ink/50 text-sm">請稍後再來看看</p>
      </div>

      <div v-else class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <article
          v-for="product in products"
          :key="product.id"
          class="relative border border-ink/20 tag-corner flex flex-col justify-between hover:border-ink transition-colors group"
        >
          <div class="tag-hole"></div>
          <div @click="goToProduct(product.id)" class="cursor-pointer p-4 pb-0">
            <div class="aspect-[4/5] overflow-hidden border border-ink/10 mb-4">
              <img
                :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=500'"
                :alt="product.name"
                class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
              />
            </div>
            <h3 class="font-bold text-lg text-ink group-hover:text-peony transition-colors" style="font-family: 'Noto Serif TC', serif;">{{ product.name }}</h3>
          </div>
          <div class="p-4 pt-4 mt-3 border-t border-ink/10 bg-ink/[0.02]">
            <div class="flex items-baseline justify-between mb-3">
              <span class="text-xs text-ink/50">定價</span>
              <span class="font-bold text-xl text-peony">NT$ {{ product.price.toLocaleString() }}</span>
            </div>
            <button
              @click="addToCart(product)"
              :disabled="product._adding || product.stock <= 0"
              class="w-full py-2 border border-ink/30 text-ink text-xs font-medium hover:bg-ink hover:text-paper transition-colors disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-ink flex items-center justify-center gap-1.5"
            >
              <span class="material-symbols-outlined text-sm" data-icon="shopping_bag" v-if="product.stock > 0">shopping_bag</span>
              {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
            </button>
          </div>
        </article>
      </div>

      <!-- Pagination -->
      <div v-if="pagination.totalPages > 1" class="flex justify-center gap-2 mt-10">
        <button
          v-for="p in pagination.totalPages"
          :key="p"
          @click="loadProducts(p)"
          class="w-9 h-9 text-sm transition-colors border"
          :class="p === pagination.page ? 'bg-ink text-paper border-ink' : 'border-ink/20 text-ink/70 hover:border-ink'"
        >
          {{ p }}
        </button>
      </div>
    </template>
  </section>

  <!-- 品牌自述 -->
  <section class="border-t border-ink/10">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14 text-center">
      <p class="text-lg sm:text-xl leading-relaxed text-ink" style="font-family: 'Noto Serif TC', serif;">
        「剪掉不必要的塑膠裝飾，留下一枝花該有的姿態。」
      </p>
      <p class="text-sm text-ink/60 mt-4 leading-relaxed">
        花漾生活成立於 2020 年，每一束花由花藝師當日剪枝、當日包裝，不做過度加工，讓花材本身的線條與氣味說話。
      </p>
    </div>
  </section>

  <!-- 配送與服務資訊 -->
  <section class="border-t border-ink/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex flex-col sm:flex-row justify-center gap-3 sm:gap-8 text-xs text-ink/60 text-center">
      <span>台北市區當日配送</span>
      <span class="hidden sm:inline text-ink/20">|</span>
      <span>消費滿 NT$ 500 免運費</span>
      <span class="hidden sm:inline text-ink/20">|</span>
      <span>7 日內鮮度不佳可申請補寄</span>
    </div>
  </section>
</div>
