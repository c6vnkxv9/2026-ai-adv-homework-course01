<div id="app" class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
  <h1 class="text-2xl font-bold text-ink mb-6" style="font-family: 'Noto Serif TC', serif;">結帳</h1>

  <div v-if="loading" class="flex justify-center py-16">
    <div class="w-8 h-8 border-2 border-ink/20 border-t-peony rounded-full animate-spin"></div>
  </div>

  <div v-else class="flex flex-col lg:flex-row gap-8">
    <!-- Left: Form -->
    <div class="lg:w-3/5">
      <div class="border border-ink/15 p-6">
        <h2 class="font-medium text-ink mb-4">收件資訊</h2>
        <div class="space-y-4">
          <div>
            <label class="block text-sm text-ink/70 mb-1">收件人姓名</label>
            <input
              v-model="form.recipientName"
              type="text"
              placeholder="請輸入收件人姓名"
              class="w-full border border-ink/20 px-3 py-2 text-sm focus:outline-none focus:border-ink transition-colors bg-paper"
              :class="{ 'border-peony': errors.recipientName }"
            />
            <p v-if="errors.recipientName" class="text-peony text-xs mt-1">{{ errors.recipientName }}</p>
          </div>
          <div>
            <label class="block text-sm text-ink/70 mb-1">Email</label>
            <input
              v-model="form.recipientEmail"
              type="email"
              placeholder="請輸入 Email"
              class="w-full border border-ink/20 px-3 py-2 text-sm focus:outline-none focus:border-ink transition-colors bg-paper"
              :class="{ 'border-peony': errors.recipientEmail }"
            />
            <p v-if="errors.recipientEmail" class="text-peony text-xs mt-1">{{ errors.recipientEmail }}</p>
          </div>
          <div>
            <label class="block text-sm text-ink/70 mb-1">收件地址</label>
            <input
              v-model="form.recipientAddress"
              type="text"
              placeholder="請輸入收件地址"
              class="w-full border border-ink/20 px-3 py-2 text-sm focus:outline-none focus:border-ink transition-colors bg-paper"
              :class="{ 'border-peony': errors.recipientAddress }"
            />
            <p v-if="errors.recipientAddress" class="text-peony text-xs mt-1">{{ errors.recipientAddress }}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Summary -->
    <div class="lg:w-2/5">
      <div class="border border-ink/15 p-6 sticky top-24">
        <h2 class="font-medium text-ink mb-4">訂單摘要</h2>
        <div class="space-y-3 mb-4">
          <div v-for="item in cartItems" :key="item.id" class="flex justify-between text-sm">
            <span class="text-ink/70">{{ item.product.name }} x {{ item.quantity }}</span>
            <span class="text-ink">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
          </div>
        </div>
        <div class="border-t border-ink/10 pt-3 space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-ink/70">商品小計</span>
            <span>NT$ {{ cartTotal.toLocaleString() }}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-ink/70">運費</span>
            <span>{{ cartTotal >= 500 ? '免運' : 'NT$ 150' }}</span>
          </div>
        </div>
        <div class="border-t border-ink/10 pt-3 mt-3 flex justify-between items-center">
          <span class="font-bold text-ink">總計</span>
          <span class="font-bold text-xl text-peony">
            NT$ {{ (cartTotal + (cartTotal >= 500 ? 0 : 150)).toLocaleString() }}
          </span>
        </div>
        <button
          @click="submitOrder"
          :disabled="submitting"
          class="w-full mt-4 bg-peony text-paper py-3 text-sm font-medium hover:bg-peony/90 transition-colors disabled:opacity-50"
        >
          {{ submitting ? '處理中...' : '確認送出訂單' }}
        </button>
      </div>
    </div>
  </div>
</div>
