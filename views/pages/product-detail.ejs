<div id="app" data-product-id="<%= productId %>" class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
  <div v-if="loading" class="flex justify-center py-16">
    <div class="w-8 h-8 border-2 border-ink/20 border-t-peony rounded-full animate-spin"></div>
  </div>

  <div v-else-if="notFound" class="text-center py-16 border border-ink/15">
    <span class="material-symbols-outlined text-4xl text-ink/40" data-icon="local_florist">local_florist</span>
    <h2 class="text-xl font-medium text-ink mt-3 mb-2" style="font-family: 'Noto Serif TC', serif;">找不到此商品</h2>
    <a href="/" class="text-ink/70 border-b border-ink/40 hover:border-peony hover:text-peony transition-colors text-sm">回到首頁</a>
  </div>

  <div v-else-if="product" class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14">
    <!-- Left: Image -->
    <div>
      <div class="border border-ink/15 overflow-hidden">
        <img
          :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=700'"
          :alt="product.name"
          class="w-full aspect-square object-cover"
        />
      </div>
    </div>

    <!-- Right: Info -->
    <div>
      <h1 class="text-2xl md:text-3xl font-bold text-ink mb-2" style="font-family: 'Noto Serif TC', serif;">
        {{ product.name }}
      </h1>
      <p class="text-3xl text-peony font-bold mb-4">NT$ {{ product.price.toLocaleString() }}</p>

      <div class="mb-6 flex items-center gap-1.5 text-sm text-moss">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-moss"></span>
        <span>尚有 {{ product.stock }} 件</span>
      </div>

      <p class="text-ink/75 leading-relaxed mb-6">{{ product.description }}</p>

      <!-- Quantity Selector -->
      <div class="flex items-center gap-4 mb-6">
        <span class="text-sm text-ink/70">數量</span>
        <div class="flex items-center border border-ink/20">
          <button
            @click="decrease"
            class="w-10 h-10 flex items-center justify-center hover:bg-ink hover:text-paper text-ink transition-colors"
          >
            −
          </button>
          <span class="w-12 h-10 flex items-center justify-center text-sm border-x border-ink/20">
            {{ quantity }}
          </span>
          <button
            @click="increase"
            class="w-10 h-10 flex items-center justify-center hover:bg-ink hover:text-paper text-ink transition-colors"
          >
            +
          </button>
        </div>
      </div>

      <button
        @click="addToCart"
        :disabled="adding || product.stock <= 0"
        class="w-full bg-peony text-paper py-3.5 text-sm font-medium hover:bg-peony/90 transition-colors disabled:opacity-50 flex items-center justify-center gap-2"
      >
        <span class="material-symbols-outlined text-base" data-icon="shopping_bag" v-if="product.stock > 0">shopping_bag</span>
        {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
      </button>

      <!-- Purchase Notes -->
      <div class="mt-8 border border-ink/15 p-5">
        <h3 class="font-medium text-ink mb-2 text-sm">購買須知</h3>
        <ul class="text-ink/60 text-xs space-y-1.5">
          <li>花材依據季節供應，實際花束可能略有差異</li>
          <li>台北市區可享當日配送服務</li>
          <li>消費滿 NT$ 500 享免運優惠</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- 你可能也喜歡 -->
  <div v-if="related.length > 0" class="mt-16 pt-10 border-t border-ink/10">
    <h2 class="font-bold text-xl text-ink mb-6" style="font-family: 'Noto Serif TC', serif;">你可能也喜歡</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 sm:gap-6">
      <article
        v-for="p in related"
        :key="p.id"
        @click="goToProduct(p.id)"
        class="relative border border-ink/20 tag-corner p-3 sm:p-4 cursor-pointer hover:border-ink transition-colors group"
      >
        <div class="tag-hole"></div>
        <div class="aspect-square overflow-hidden border border-ink/10 mb-3">
          <img
            :src="p.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=500'"
            :alt="p.name"
            class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
          />
        </div>
        <h3 class="font-medium text-sm text-ink truncate">{{ p.name }}</h3>
        <p class="text-peony font-bold mt-1">NT$ {{ p.price.toLocaleString() }}</p>
      </article>
    </div>
  </div>
</div>
